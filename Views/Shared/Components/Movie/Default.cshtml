@model RapidApiAkademiq.Models.MovieViewModel.Rootobject

<style>
    body {
        background-color: #080808;
        color: #ffffff;
    }

    .movie-card {
        background: #161616;
        border: 1px solid #282828;
        border-radius: 15px;
        transition: 0.3s ease;
        overflow: hidden;
    }

        .movie-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            border-color: #e50914;
        }

    .poster-wrapper {
        position: relative;
        height: 350px;
    }

    .poster-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .rating-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #f5c518;
        color: #000;
        font-weight: 800;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }

    .movie-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 8px;
    }

    .movie-meta {
        color: #ced4da !important;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .movie-desc {
        color: #adb5bd !important;
        line-height: 1.5;
        font-size: 0.88rem;
    }

    .genre-pill {
        font-size: 0.75rem;
        background: #2a2a2a;
        color: #ffffff;
        border: 1px solid #444;
        padding: 4px 10px;
        border-radius: 50px;
        margin-right: 6px;
        font-weight: 500;
    }

    .btn-trailer {
        background-color: #e50914;
        color: white;
        border: none;
        font-weight: 700;
        padding: 10px;
        transition: 0.3s;
    }

        .btn-trailer:hover {
            background-color: #ff0a16;
            color: white;
            box-shadow: 0 0 15px rgba(229, 9, 20, 0.4);
        }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-film text-danger me-2"></i>Popüler Filmler
            </h2>
            <p class="text-light opacity-75 mb-0">Haftanın en çok konuşulan yapımları</p>
        </div>
        @if (Model?.Property1 != null)
        {
            <div class="badge bg-danger p-2 px-3 rounded-pill shadow">
                Toplam @Model.Property1.Length Yapım
            </div>
        }
    </div>

    <div class="row g-4">
        @if (Model?.Property1 != null && Model.Property1.Any())
        {
            @foreach (var movie in Model.Property1)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card h-100 movie-card shadow">
                        <div class="poster-wrapper">
                            <img src="@(string.IsNullOrEmpty(movie.primaryImage) ? "https://via.placeholder.com/300x450?text=Afiş+Yok" : movie.primaryImage)"
                                 class="poster-img" alt="@movie.primaryTitle">

                            @* Puan Formatlama *@
                            @if (movie.averageRating.HasValue && movie.averageRating > 0)
                            {
                                <div class="rating-badge">
                                    <i class="bi bi-star-fill me-1"></i> @movie.averageRating.Value.ToString("0.0")
                                </div>
                            }
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="movie-title text-truncate">@movie.primaryTitle</h5>

                            <div class="movie-meta mb-3">
                                <span class="badge bg-secondary">@(movie.startYear?.ToString() ?? "N/A")</span>
                                <span class="mx-2 text-muted">|</span>
                                @* Süre Kontrolü *@
                                <span><i class="bi bi-clock-history text-danger me-1"></i> @(movie.runtimeMinutes.HasValue? movie.runtimeMinutes + " dk" : "Süre Belirsiz")</span>
                            </div>

                            <div class="mb-3 d-flex flex-wrap gap-1">
                                @if (movie.genres != null && movie.genres.Any())
                                {
                                    @foreach (var genre in movie.genres.Take(2))
                                    {
                                        <span class="genre-pill">@genre</span>
                                    }
                                }
                            </div>

                            <p class="movie-desc mb-4" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(movie.description) ? "Bu yapım için henüz bir özet bilgisi eklenmemiş." : movie.description)
                            </p>

                            <div class="mt-auto pt-3 border-top border-secondary">
                                <div class="d-flex justify-content-between align-items-center">
                                    <a href="@(string.IsNullOrEmpty(movie.trailer) ? "#" : movie.trailer)" target="_blank" class="btn btn-trailer btn-sm rounded-pill px-4">
                                        <i class="bi bi-play-circle-fill me-2"></i>Fragman
                                    </a>
                                    <span class="badge border border-secondary text-light fw-normal">@(movie.contentRating ?? "G")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-camera-reels fs-1 text-danger opacity-50"></i>
                <h4 class="mt-3 text-white">Film Verileri Yüklenemedi</h4>
                <p class="text-muted small">API bağlantınızı veya limitlerinizi kontrol edin.</p>
            </div>
        }
    </div>
</div>