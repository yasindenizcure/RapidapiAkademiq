@model RapidApiAkademiq.Models.QuoteViewModel.Rootobject
@{
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-chat-quote-fill me-2"></i> Günün Sözü</span>
                    <span class="badge bg-light text-primary text-uppercase">@Model.type</span>
                </div>
                <div class="card-body p-4 text-center">
                    <i class="bi bi-quote fs-1 text-secondary opacity-25"></i>

                    <blockquote class="blockquote mb-4">
                        <p class="fs-4 fw-normal italic">"@Model.quote"</p>
                        <footer class="blockquote-footer mt-2">
                            <cite title="Source Title" class="fw-bold text-dark">@Model.author</cite>
                        </footer>
                    </blockquote>

                    <div class="border-top pt-3 mt-3">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i> Bu söz API üzerinden anlık olarak getirilmiştir.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>