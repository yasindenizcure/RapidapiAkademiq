@model RapidApiAkademiq.Models.FoodViewModel.Rootobject

@{
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background-color: #fffaf0;
    }
    .recipe-card {
        border: none;
        border-radius: 20px;
        transition: 0.3s;
        overflow: hidden;
    }

        .recipe-card:hover {
            transform: scale(1.02);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .img-container {
        position: relative;
        height: 220px;
    }

    .recipe-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .time-badge {
        position: absolute;
        bottom: 10px;
        left: 10px;
        background: rgba(0,0,0,0.7);
        color: white;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 0.8rem;
    }

    .score-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #ffc107;
        color: #000;
        font-weight: bold;
        padding: 5px 10px;
        border-radius: 10px;
    }
</style>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-dark"><i class="bi bi-journal-richtext text-danger"></i> Şefin Seçimleri</h1>
        <p class="lead text-muted">RapidAPI & Tasty iş birliğiyle bugün ne pişirsek?</p>
    </div>

    <div class="row g-4">
        @if (Model?.results != null)
        {
            @foreach (var recipe in Model.results.Take(12)) // İlk 12 tarifi göster
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm recipe-card">
                        <div class="img-container">
                            <img src="@recipe.thumbnail_url" class="recipe-img" alt="@recipe.name">
                            <span class="time-badge"><i class="bi bi-clock me-1"></i> @(recipe.cook_time_minutes > 0 ? recipe.cook_time_minutes + " dk" : "Pratik")</span>
                            <span class="score-badge"><i class="bi bi-star-fill"></i> @((recipe.user_ratings?.score * 100)?.ToString("0"))%</span>
                        </div>

                        <div class="card-body">
                            <h5 class="fw-bold text-truncate" title="@recipe.name">@recipe.name</h5>
                            <p class="card-text text-muted small" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(recipe.description) ? "Lezzetli bir tarif sizi bekliyor..." : recipe.description)
                            </p>

                            <div class="d-grid mt-3">
                                <button class="btn btn-outline-danger rounded-pill fw-bold btn-sm" data-bs-toggle="modal" data-bs-target="#modal-@recipe.name.GetHashCode()">
                                    Tarifi Gör
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="modal-@recipe.name.GetHashCode()" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 rounded-4">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title fw-bold">Nasıl Yapılır?</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <h4 class="mb-3">@recipe.name</h4>
                                <ol class="list-group list-group-numbered">
                                    @if (recipe.instructions != null)
                                    {
                                        @foreach (var step in recipe.instructions)
                                        {
                                            <li class="list-group-item border-0 ps-0 text-dark">@step.display_text</li>
                                        }
                                    }
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>