@model RapidApiAkademiq.Models.NewsViewModel.Rootobject

<style>
    .news-card {
        border: none;
        border-radius: 16px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #fff;
    }

        .news-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.1) !important;
        }

    .news-img {
        height: 200px;
        object-fit: cover;
        border-radius: 16px 16px 0 0;
    }

    .source-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(255, 255, 255, 0.9);
        padding: 5px 12px;
        border-radius: 50px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .source-logo {
        width: 18px;
        height: 18px;
        border-radius: 4px;
    }

    .news-title {
        font-weight: 700;
        font-size: 1.1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        color: #1e1e2d;
    }

    .news-snippet {
        font-size: 0.9rem;
        color: #6c757d;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .time-area {
        font-size: 0.8rem;
        color: #a2a3b7;
    }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Son Dakika Haberleri</h3>
            <p class="text-muted small">Dünya çapındaki güvenilir kaynaklardan anlık akış</p>
        </div>
        <div class="dropdown">
            <button class="btn btn-white shadow-sm dropdown-toggle rounded-3" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-filter me-2"></i> Sırala
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">En Yeni</a></li>
                <li><a class="dropdown-item" href="#">Popüler</a></li>
            </ul>
        </div>
    </div>

    <div class="row g-4">
        @if (Model?.data != null)
        {
            @foreach (var item in Model.data)
            {
                <div class="col-xl-4 col-md-6">
                    <div class="card h-100 news-card shadow-sm">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(item.photo_url) ? "https://via.placeholder.com/400x200?text=Haber+Görseli" : item.photo_url)"
                                 class="card-img-top news-img" alt="@item.title">

                            <div class="source-badge">
                                @if (!string.IsNullOrEmpty(item.source_logo_url))
                                {
                                    <img src="@item.source_logo_url" class="source-logo" alt="logo">
                                }
                                <span class="fw-bold text-dark small">@item.source_name</span>
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="news-title mb-2">@item.title</h5>
                            <p class="news-snippet mb-3">@item.snippet</p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <div class="time-area">
                                    <i class="bi bi-clock me-1"></i>
                                    @item.published_datetime_utc.ToString("dd.MM.yyyy HH:mm")
                                </div>
                                <a href="@item.link" target="_blank" class="btn btn-link btn-sm text-primary fw-bold text-decoration-none p-0">
                                    Devamını Oku <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>

                        @if (item.related_topics != null && item.related_topics.Any())
                        {
                            <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                                @foreach (var topic in item.related_topics.Take(2))
                                {
                                    <span class="badge bg-light text-secondary fw-normal me-1">#@topic.topic_name</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 text-muted">Haberler yükleniyor, lütfen bekleyin...</p>
            </div>
        }
    </div>
</div>