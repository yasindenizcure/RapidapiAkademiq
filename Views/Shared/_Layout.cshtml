<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RapidApi Akademiq</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --sidebar-width: 260px;
            --topbar-height: 60px;
            --bg-dark: #1e1e2d;
            --bg-light: #f5f8fa;
            --accent-color: #009ef7;
        }

        body {
            background-color: var(--bg-light);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        #sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background-color: var(--bg-dark);
            color: #a2a3b7;
            transition: all 0.3s;
            z-index: 1000;
        }

            #sidebar .nav-link {
                color: #a2a3b7;
                padding: 12px 25px;
                margin: 4px 15px;
                border-radius: 8px;
                display: flex;
                align-items: center;
                font-weight: 500;
                transition: 0.2s;
                text-decoration: none;
            }

                #sidebar .nav-link:hover, #sidebar .nav-link.active {
                    background-color: #2b2b40;
                    color: #fff;
                }

                #sidebar .nav-link i {
                    font-size: 1.2rem;
                    margin-right: 15px;
                }

                #sidebar .nav-link.active {
                    color: var(--accent-color);
                }

        #main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: all 0.3s;
        }

        .topbar {
            height: var(--topbar-height);
            background: #fff;
            display: flex;
            align-items: center;
            padding: 0 30px;
            box-shadow: 0 0 20px 0 rgba(76,87,125,.02);
        }

        .content-area {
            padding: 30px;
        }

        .logo-area {
            padding: 30px 25px;
            font-size: 1.5rem;
            font-weight: bold;
            color: white;
            border-bottom: 1px solid #2b2b40;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <div id="sidebar">
        <div class="logo-area">
            <i class="bi bi-cpu-fill text-primary"></i> Akademiq
        </div>

        <nav class="nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" href="/Dashboard/Index">
                <i class="bi bi-grid-1x2-fill"></i> Genel Bakış
            </a>
            <a class="nav-link" href="/Dashboard/Weather"><i class="bi bi-cloud-sun-fill"></i> Hava Durumu</a>
            <a class="nav-link" href="/Dashboard/ExchangeRate"><i class="bi bi-currency-exchange"></i> Döviz</a>
            <a class="nav-link" href="/Dashboard/Crypto"><i class="bi bi-currency-bitcoin"></i> Kripto Paralar</a>
            <a class="nav-link" href="/Dashboard/Gas"><i class="bi bi-fuel-pump-fill"></i> Akaryakıt</a>
            <a class="nav-link" href="/Dashboard/Football"><i class="bi bi-trophy-fill"></i> Spor</a>
            <a class="nav-link" href="/Dashboard/Music"><i class="bi bi-music-note-beamed"></i> Müzik</a>
            <a class="nav-link" href="/Dashboard/Food"><i class="bi bi-egg-fried"></i> Yemek</a>
            <a class="nav-link" href="/Dashboard/Quote"><i class="bi bi-chat-quote-fill"></i> Günün Sözü</a>
            <a class="nav-link" href="/Dashboard/News"><i class="bi bi-newspaper"></i> Son Haberler</a>
            <a class="nav-link" href="/Dashboard/Movie"><i class="bi bi-film"></i> Film Dünyası</a>
        </nav>
    </div>

    <div id="main-content">
        <header class="topbar d-flex justify-content-between">
            <h5 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h5>
            <div class="user-profile d-flex align-items-center">
                <span class="text-muted small">Hoş geldin, <strong>Admin</strong></span>
                <i class="bi bi-person-circle fs-4 ms-2 text-primary align-middle"></i>
            </div>
        </header>

        <main class="content-area">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>